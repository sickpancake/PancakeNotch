# macOS
.DS_Store

# SwiftPM / build output
/.build/
/build/
/.swiftpm/
*.dSYM/

# Xcode (not used, ADR-0014) — keep it out if someone opens the package there
*.xcodeproj/
*.xcworkspace/
xcuserdata/
DerivedData/

# Rendered logo PNGs: made locally by design/logo/render-logo.swift, not kept in git
design/logo/*.png
# App icon PNGs: made locally by design/icon/render.swift, not kept in git
design/icon/*.png

# Editors
.vscode/
.idea/
*.swp

# AI agent notes and settings: kept locally, not published
AGENTS.md
CLAUDE.md
CONTEXT.md
docs/adr/
.claude/

# Secrets: signing certificates and Sparkle keys must never be committed (ADR-0005)
*.p12
*.pem
*.cer
*.key
.env

# Extra build folders (parallel builds)
/.build-*/
